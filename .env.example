# ─── Banco de dados (Prisma Postgres na Vercel) ───────────────────────────────
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET=""

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
# A Vercel envia "Authorization: Bearer $CRON_SECRET" nas chamadas agendadas.
CRON_SECRET=""
# Chave do agendador externo que chama /api/cron/tick?key=... a cada 5 min (mín. 20 caracteres).
TICK_SECRET=""

# ─── Armazenamento de fotos (Vercel Blob) ────────────────────────────────────
# Sem esta variável, em desenvolvimento as fotos ficam em .data/uploads.
BLOB_READ_WRITE_TOKEN=""

# ─── Notificações push (Web Push / VAPID) ─────────────────────────────────────
# Use as MESMAS chaves do projeto antigo para os aparelhos continuarem inscritos.
# Para gerar novas: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ti@engemase.com.br"

# ─── Integrações (opcionais) ──────────────────────────────────────────────────
TRELLO_API_KEY=""
TRELLO_TOKEN=""
# IDs das listas do Trello separados por vírgula (padrão: A Fazer, Fazendo Curto e Longo Prazo)
TRELLO_LIST_IDS=""
GOOGLE_SHEETS_API_KEY=""
GOOGLE_SHEET_ID=""

# ─── Sentry (opcional) ────────────────────────────────────────────────────────
VITE_SENTRY_DSN=""
